---
import { site } from '../lib/content';
---

<video
  id="backdrop"
  aria-hidden="true"
  transition:persist
  class="fixed inset-x-0 bottom-0 -z-50 h-lvh w-full object-cover object-bottom max-md:mask-[linear-gradient(transparent_calc(100lvh-100dvh),black_calc(100lvh-100dvh+2rem),black_calc(100%-2rem),transparent)]"
  data-videos={JSON.stringify(site.videos)}
  preload="auto"
  muted
  loop
  playsinline
></video>

<button
  id="backdrop-toggle"
  type="button"
  transition:persist
  class="group fixed right-2 bottom-2 z-50 cursor-pointer rounded-sm p-2 opacity-30 outline-offset-2 blur-xxs transition-[filter,opacity] focus-visible:opacity-100 focus-visible:outline-2 focus-visible:blur-none can-hover:hover:opacity-100 can-hover:hover:blur-none"
>
  <svg viewBox="0 0 12 12" aria-hidden="true" class="size-3 fill-current group-data-paused:hidden">
    <rect x="2" y="1" width="3" height="10" />
    <rect x="7" y="1" width="3" height="10" />
  </svg>
  <svg viewBox="0 0 12 12" aria-hidden="true" class="hidden size-3 fill-current group-data-paused:block">
    <path d="M2 1 11 6 2 11z" />
  </svg>
</button>

<script>
  // biome-ignore lint/style/noNonNullAssertion: element is rendered above
  const video = document.querySelector<HTMLVideoElement>('#backdrop')!;
  // biome-ignore lint/style/noNonNullAssertion: data-videos is always set
  const videos: Record<string, string> = JSON.parse(video.dataset.videos!);
  const mobile = matchMedia('(width < 768px)');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  // biome-ignore lint/style/noNonNullAssertion: element is rendered above
  const toggle = document.querySelector<HTMLButtonElement>('#backdrop-toggle')!;
  // The visitor's own pause or play wins over the reduced motion setting, until a full reload.
  let choice: 'paused' | 'playing' | null = null;

  const shouldPlay = () => (choice ? choice === 'playing' : !still.matches);

  function setSource() {
    const src = videos[`${mobile.matches ? 'mobile' : 'desktop'}_${window.theme}`];
    // The time fragment makes Safari paint the first frame without playing.
    video.src = still.matches ? `${src}#t=0.001` : src;
    setPlaying();
  }

  function setPlaying() {
    if (shouldPlay()) video.play().catch(() => {});
    else video.pause();
  }

  // Follows the video itself, since browsers can refuse to play it.
  function setToggle() {
    toggle.toggleAttribute('data-paused', video.paused);
    toggle.ariaLabel = video.paused ? 'Spela bakgrundsvideo' : 'Pausa bakgrundsvideo';
  }

  setToggle();
  video.addEventListener('play', setToggle);
  video.addEventListener('pause', setToggle);
  setSource();
  mobile.addEventListener('change', setSource);
  still.addEventListener('change', setPlaying);
  toggle.addEventListener('click', () => {
    choice = video.paused ? 'playing' : 'paused';
    setPlaying();
  });
</script>
