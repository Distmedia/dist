---
import { ClientRouter } from 'astro:transitions';
import type { ComponentProps } from 'astro/types';
import '../styles/global.css';
import Backdrop from '../components/Backdrop.astro';
import Navbar from '../components/Navbar.astro';
import { site } from '../lib/content';
import { mediaImage } from '../lib/media';
import { themes } from '../lib/themes';

interface Props {
  title?: string;
  description?: string;
  image?: { src: string; width: number; height: number; alt: string };
  schema?: object | object[];
  detail?: ComponentProps<typeof Navbar>['detail'];
  overlay?: boolean;
  noindex?: boolean;
}

const thumbnail = mediaImage(site.thumbnail);
const { title, description = site.descriptions.home, image = { src: site.thumbnail, width: thumbnail.width, height: thumbnail.height, alt: 'DIST' }, schema, detail, overlay = false, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · DIST` : site.title;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site).href;
const imageUrl = new URL(image.src, Astro.site).href;
const indexable = process.env.CONTEXT === 'production' && !noindex;
---

<!doctype html>
<html lang="sv" class="theme">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {!indexable && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DIST" />
    <meta property="og:locale" content="sv_SE" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
    <link rel="icon" href={site.favicon} />
    <link rel="preload" href="/fonts/KarlST_Bold.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline define:vars={{ themes }}>
      // One random theme per full load, kept across client-side navigation.
      window.theme ??= themes[Math.floor(Math.random() * themes.length)];
      const applyTheme = (doc) => doc.documentElement.classList.add(`theme--${window.theme}`);
      applyTheme(document);
      document.addEventListener('astro:before-swap', (event) => applyTheme(event.newDocument));
    </script>
    <ClientRouter />
  </head>
  <body>
    {overlay && <div class="fixed inset-x-0 bottom-0 -z-40 h-lvh theme-red:bg-backdrop-red/80 theme-green:bg-backdrop-green/80 theme-blue:bg-backdrop-blue/80 theme-purple:bg-backdrop-purple/80"></div>}
    <Navbar detail={detail} />
    <slot />
    <Backdrop />
  </body>
</html>
