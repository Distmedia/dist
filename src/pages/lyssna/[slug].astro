---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Column from '../../components/Column.astro';
import Rich from '../../components/Rich.astro';
import Layout from '../../layouts/Layout.astro';
import { lyssna } from '../../lib/content';
import { hasPage } from '../../lib/productions';
import { excerpt } from '../../lib/seo';

export const getStaticPaths = (() =>
  lyssna.productions
    .filter(hasPage)
    .map((production) => ({ params: { slug: production.slug }, props: { production } }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { production } = Astro.props;
---

<Layout title={production.title} description={excerpt(production.info)} detail={{ title: production.title, back: '/lyssna' }} overlay>
  <Column indent={3}>
    <Rich html={production.info} />
  </Column>
</Layout>
